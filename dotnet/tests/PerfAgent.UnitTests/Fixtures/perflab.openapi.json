{
  "openapi": "3.1.1",
  "info": {
    "title": "PerfLab.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:51264/"
    }
  ],
  "paths": {
    "/api/baseline": {
      "get": {
        "tags": [
          "lab"
        ],
        "operationId": "GetBaseline",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/products/{id}": {
      "get": {
        "tags": [
          "lab"
        ],
        "operationId": "GetProduct",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/cpu/report": {
      "get": {
        "tags": [
          "lab"
        ],
        "operationId": "GetCpuReport",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/alloc/report": {
      "get": {
        "tags": [
          "lab"
        ],
        "operationId": "GetAllocationReport",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/blocking/report": {
      "get": {
        "tags": [
          "lab"
        ],
        "operationId": "GetBlockingReport",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/dependency/quote": {
      "get": {
        "tags": [
          "lab"
        ],
        "operationId": "GetDependencyQuote",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/orders": {
      "post": {
        "tags": [
          "lab"
        ],
        "operationId": "CreateOrder",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateOrderRequest": {
        "required": [
          "productId",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "lab"
    }
  ]
}